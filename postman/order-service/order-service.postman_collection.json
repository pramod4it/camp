{
  "info": {
    "name": "order-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Approved Order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Correlation-Id", "value": "{{correlation_id}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": {{user_id}},\n  \"productId\": {{product_id}},\n  \"quantity\": 1,\n  \"amount\": 2500.00\n}"
        },
        "url": "{{gateway_url}}/api/v1/orders"
      }
    },
    {
      "name": "Create Declined Payment Order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Correlation-Id", "value": "{{correlation_id}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": {{user_id}},\n  \"productId\": {{product_id}},\n  \"quantity\": 1,\n  \"amount\": 7000.00\n}"
        },
        "url": "{{gateway_url}}/api/v1/orders"
      }
    },
    {
      "name": "Create Inventory Rejection Order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Correlation-Id", "value": "{{correlation_id}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": {{user_id}},\n  \"productId\": 1002,\n  \"quantity\": 999,\n  \"amount\": 1200.00\n}"
        },
        "url": "{{gateway_url}}/api/v1/orders"
      }
    },
    {
      "name": "List Orders",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-Correlation-Id", "value": "{{correlation_id}}" }
        ],
        "url": "{{gateway_url}}/api/v1/orders"
      }
    },
    {
      "name": "Get Order By Id",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-Correlation-Id", "value": "{{correlation_id}}" }
        ],
        "url": "{{gateway_url}}/api/v1/orders/{{order_id}}"
      }
    },
    {
      "name": "Swagger UI",
      "request": {
        "method": "GET",
        "url": "{{order_service_url}}/swagger-ui.html"
      }
    }
  ]
}
