{
  "info": {
    "name": "api-gateway",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Gateway Health",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-Correlation-Id", "value": "{{correlation_id}}" }
        ],
        "url": "{{gateway_url}}/actuator/health"
      }
    },
    {
      "name": "Gateway Swagger UI",
      "request": {
        "method": "GET",
        "url": "{{gateway_url}}/swagger-ui.html"
      }
    },
    {
      "name": "User Service OpenAPI Via Gateway",
      "request": {
        "method": "GET",
        "url": "{{gateway_url}}/v3/api-docs/user-service"
      }
    },
    {
      "name": "Order Service OpenAPI Via Gateway",
      "request": {
        "method": "GET",
        "url": "{{gateway_url}}/v3/api-docs/order-service"
      }
    }
  ]
}
